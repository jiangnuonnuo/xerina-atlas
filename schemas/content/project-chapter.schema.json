{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xerina project chapter frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "type", "project", "order", "layout"],
  "properties": {
    "type": { "const": "project-chapter" },
    "title": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "order": { "type": "integer" },
    "layout": { "const": "project-doc" }
  }
}
