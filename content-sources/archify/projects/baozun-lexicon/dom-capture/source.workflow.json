{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "字段采集双入口",
    "subtitle": "人工高精度采集与 Agent 自动探索最终汇入同一字段快照",
    "output": "../dom-capture.html",
    "visual_preset": "classic",
    "quality_profile": "showcase",
    "views": [
      { "id": "manual", "label": "人工采集", "focus": ["select", "copy", "sanitize", "snapshot"], "note": "Easy Copy DOM 适合指定区域和复杂页面的高精度兜底。" },
      { "id": "automatic", "label": "自动采集", "focus": ["scope", "discover", "capture", "sanitize", "snapshot"], "note": "Agent 规划可达状态，浏览器工具执行确定性动作。" },
      { "id": "degrade", "label": "异常降级", "focus": ["capture", "inaccessible", "fallback"], "note": "不可访问区域被明确标记，并转人工补采。" }
    ]
  },
  "lanes": [
    { "id": "manual", "label": "人工入口" },
    { "id": "auto", "label": "自动入口" },
    { "id": "unified", "label": "统一处理" },
    { "id": "exceptions", "label": "降级处理", "variant": "exception" }
  ],
  "phases": [
    { "id": "collect", "label": "采集", "fromCol": 0, "toCol": 3 },
    { "id": "normalize", "label": "标准化", "fromCol": 4, "toCol": 5, "variant": "emphasis" }
  ],
  "groups": [
    { "id": "manual-group", "label": "Easy Copy DOM", "lane": "manual", "fromCol": 0, "toCol": 2, "variant": "default" },
    { "id": "agent-group", "label": "受限浏览器工具", "lane": "auto", "fromCol": 0, "toCol": 5, "variant": "dashed" }
  ],
  "nodes": [
    { "id": "select", "lane": "manual", "col": 0, "type": "external", "label": "点选页面区域", "sublabel": "人工确定边界" },
    { "id": "copy", "lane": "manual", "col": 2, "type": "frontend", "label": "复制 outerHTML", "sublabel": "粘贴到转换框" },
    { "id": "scope", "lane": "auto", "col": 0, "type": "security", "label": "限定采集范围", "sublabel": "账号 / URL / 场景" },
    { "id": "discover", "lane": "auto", "col": 3, "type": "backend", "label": "状态探索", "sublabel": "受限点击、展开、滚动", "tag": "安全动作" },
    { "id": "capture", "lane": "auto", "col": 5, "type": "cloud", "label": "采集 DOM", "sublabel": "稳定后生成快照" },
    { "id": "sanitize", "lane": "unified", "col": 4, "type": "security", "label": "清洗脱敏", "sublabel": "只保留字段定义", "width": 72 },
    { "id": "snapshot", "lane": "unified", "col": 5, "type": "database", "label": "字段快照", "sublabel": "证据 + 状态 + 顺序", "tag": "统一契约", "width": 72 },
    { "id": "inaccessible", "lane": "exceptions", "col": 3, "type": "security", "label": "不可访问区域", "sublabel": "权限 / iframe / 画布" },
    { "id": "fallback", "lane": "exceptions", "col": 1, "type": "frontend", "label": "人工补采", "sublabel": "记录未覆盖原因" }
  ],
  "edges": [
    { "id": "manual-copy", "from": "select", "to": "copy" },
    { "id": "manual-sanitize", "from": "copy", "to": "sanitize", "variant": "emphasis", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "bias": 0.72 },
    { "id": "discover-capture", "from": "discover", "to": "capture" },
    { "id": "capture-sanitize", "from": "capture", "to": "sanitize", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "sanitize-snapshot", "from": "sanitize", "to": "snapshot", "variant": "emphasis" },
    { "id": "capture-inaccessible", "from": "capture", "to": "inaccessible", "variant": "security", "role": "error", "fromSide": "right", "toSide": "top", "route": "outside-right" },
    { "id": "inaccessible-fallback", "from": "inaccessible", "to": "fallback", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "统一输出", "items": ["两种入口都输出同一字段快照", "后续解析无需关心 DOM 从哪里来"] },
    { "dot": "rose", "title": "边界", "items": ["只采集字段定义", "不采集业务值、凭证和接口载荷"] }
  ]
}
