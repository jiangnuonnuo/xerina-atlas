{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "字段目录变更治理闭环",
    "subtitle": "发现变化不等于直接改目录：先比较、再解释、后审核，最后才应用",
    "output": "../change-governance.html",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      { "id": "main", "label": "主治理链", "focus": ["snapshot", "identity", "changes", "review", "apply", "release"], "note": "每次变更都有来源、差异和审核结果。" },
      { "id": "uncertain", "label": "不确定变化", "focus": ["identity", "uncertain", "review"], "note": "无法稳定判断同一节点时，停止自动合并并交由人工。" },
      { "id": "reject", "label": "拒绝与保留", "focus": ["review", "rejected", "release"], "note": "拒绝是有价值的治理记录，不是系统失败。" }
    ]
  },
  "lanes": [
    { "id": "capture", "label": "来源快照" },
    { "id": "diff", "label": "差异识别" },
    { "id": "review", "label": "审核决策" },
    { "id": "catalog", "label": "目录应用" },
    { "id": "release", "label": "发布留痕" },
    { "id": "exceptions", "label": "待确认情况", "variant": "exception" }
  ],
  "phases": [
    { "id": "observe", "label": "观察", "fromCol": 0, "toCol": 1 },
    { "id": "decide", "label": "解释与审核", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "apply", "label": "应用与留痕", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["snapshot", "identity", "changes", "review", "apply", "release"],
  "nodes": [
    { "id": "snapshot", "lane": "capture", "col": 0, "type": "database", "label": "采集新快照", "sublabel": "页面状态与证据" },
    { "id": "identity", "lane": "diff", "col": 1, "type": "backend", "label": "节点身份匹配", "sublabel": "来源、位置、语义特征" },
    { "id": "changes", "lane": "diff", "col": 3, "type": "messagebus", "label": "生成变化集", "sublabel": "新增、删除、改名、移动" },
    { "id": "review", "lane": "review", "col": 4, "type": "frontend", "label": "人工审核", "sublabel": "逐项接受、修改、拒绝" },
    { "id": "apply", "lane": "catalog", "col": 5, "type": "backend", "label": "受控应用变更", "sublabel": "结构事务与审计记录" },
    { "id": "release", "lane": "release", "col": 5, "type": "database", "label": "发布目录快照", "sublabel": "可回看、可交付" },
    { "id": "uncertain", "lane": "exceptions", "col": 1, "type": "security", "label": "身份不确定", "sublabel": "可能是改名，也可能是新字段" },
    { "id": "rejected", "lane": "exceptions", "col": 3, "type": "security", "label": "拒绝变化", "sublabel": "保留理由，目录不变" }
  ],
  "edges": [
    { "id": "snapshot-identity", "from": "snapshot", "to": "identity", "variant": "emphasis" },
    { "id": "identity-changes", "from": "identity", "to": "changes", "variant": "emphasis" },
    { "id": "changes-review", "from": "changes", "to": "review", "label": "候选变化", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "review-apply", "from": "review", "to": "apply", "label": "接受后的变化", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "apply-release", "from": "apply", "to": "release", "variant": "emphasis" },
    { "id": "identity-uncertain", "from": "identity", "to": "uncertain", "label": "无法稳定匹配", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "uncertain-review", "from": "uncertain", "to": "review", "label": "人工归因", "variant": "dashed", "fromSide": "top", "toSide": "top", "route": "up-channel" },
    { "id": "review-rejected", "from": "review", "to": "rejected", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop" }
  ],
  "cards": [
    { "dot": "cyan", "title": "变化是可解释对象", "items": ["不把简单文本差异直接当成结构变更", "移动和改名保留原始证据", "审核结论可回看并可重新判断"] },
    { "dot": "rose", "title": "高风险默认停下", "items": ["身份不确定时不自动合并", "删除先作为候选，不直接抹去历史", "拒绝结论同样留痕"] }
  ]
}
