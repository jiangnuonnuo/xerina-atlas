{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "ReAct 层级解析编排",
    "subtitle": "应用层负责编排工具、质量门和人工回路；内部 Agent 引擎不在本文档展开",
    "output": "../react-orchestration.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      { "id": "happy-path", "label": "主路径", "focus": ["snapshot", "compose", "extract", "hierarchy", "rules", "semantic", "preview"], "note": "从证据包到可预览结果的受控主路径。" },
      { "id": "repair", "label": "修复回路", "focus": ["rules", "repair", "extract", "hierarchy"], "note": "规则失败回到最小必要节点，而不是整段盲目重跑。" },
      { "id": "human", "label": "人工介入", "focus": ["semantic", "preview", "review"], "note": "语义歧义保持可见并交给人确认。" }
    ]
  },
  "lanes": [
    { "id": "application", "label": "字段平台应用" },
    { "id": "agent", "label": "内部 Agent 能力" },
    { "id": "quality", "label": "质量门" },
    { "id": "exceptions", "label": "修复与人工介入", "variant": "exception" }
  ],
  "phases": [
    { "id": "prepare", "label": "准备证据", "fromCol": 0, "toCol": 1 },
    { "id": "reason", "label": "受限推理", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "verify", "label": "验证与交付", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["snapshot", "compose", "extract", "hierarchy", "rules", "semantic", "preview"],
  "nodes": [
    { "id": "snapshot", "lane": "application", "col": 0, "type": "database", "label": "加载证据快照", "sublabel": "DOM 与页面状态" },
    { "id": "compose", "lane": "application", "col": 1, "type": "frontend", "label": "组装任务上下文", "sublabel": "规则、契约、反馈" },
    { "id": "extract", "lane": "agent", "col": 2, "type": "backend", "label": "字段候选抽取", "sublabel": "仅使用允许工具", "tag": "Observe" },
    { "id": "hierarchy", "lane": "agent", "col": 3, "type": "backend", "label": "层级关系判断", "sublabel": "父子、同级、排序", "tag": "Reason" },
    { "id": "rules", "lane": "quality", "col": 4, "type": "security", "label": "结构规则校验", "sublabel": "去重、深度、证据", "tag": "硬门槛" },
    { "id": "semantic", "lane": "quality", "col": 5, "type": "security", "label": "语义一致性检查", "sublabel": "标签与父级是否合理", "tag": "软门槛" },
    { "id": "preview", "lane": "application", "col": 5, "type": "frontend", "label": "流式预览", "sublabel": "候选树与疑点" },
    { "id": "repair", "lane": "exceptions", "col": 4, "type": "messagebus", "label": "最小修复指令", "sublabel": "指出违反规则的位置" },
    { "id": "review", "lane": "exceptions", "col": 5, "type": "frontend", "label": "人工反馈", "sublabel": "锁定正确节点或重述意图" }
  ],
  "edges": [
    { "id": "snapshot-compose", "from": "snapshot", "to": "compose", "variant": "emphasis" },
    { "id": "compose-extract", "from": "compose", "to": "extract", "label": "开始任务", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "extract-hierarchy", "from": "extract", "to": "hierarchy", "variant": "emphasis" },
    { "id": "hierarchy-rules", "from": "hierarchy", "to": "rules", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "rules-semantic", "from": "rules", "to": "semantic", "variant": "emphasis" },
    { "id": "semantic-preview", "from": "semantic", "to": "preview", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "up-channel" },
    { "id": "rules-repair", "from": "rules", "to": "repair", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "repair-extract", "from": "repair", "to": "extract", "label": "只修不合格处", "variant": "dashed", "fromSide": "left", "toSide": "left", "route": "return-left" },
    { "id": "semantic-review", "from": "semantic", "to": "review", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "review-compose", "from": "review", "to": "compose", "label": "带反馈重跑", "variant": "dashed", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel" }
  ],
  "cards": [
    { "dot": "emerald", "title": "先规则，后入库", "items": ["没有 DOM 证据的候选节点不通过", "硬规则失败触发可定位修复", "语义歧义不伪装成确定答案"] },
    { "dot": "rose", "title": "避免整段重跑", "items": ["反馈与错误绑定到节点", "修复只带最小上下文", "人工锁定结果不会被模型覆盖"] }
  ]
}
