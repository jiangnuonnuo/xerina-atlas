{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "字段字典导出任务生命周期",
    "subtitle": "将进度展示和可恢复执行拆开：网络抖一下，任务不该顺便失忆",
    "output": "../export-task-lifecycle.html",
    "viewBox": [1020, 700],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      { "id": "main", "label": "主执行路径", "focus": ["pending", "running", "snapshot", "writing", "success"], "note": "任务从受理到产物提交具有明确顺序。" },
      { "id": "retry", "label": "恢复路径", "focus": ["snapshot", "writing", "retry", "running", "failed"], "note": "可恢复错误回到最近检查点，而不是从头把同一个错误再演三遍。" },
      { "id": "terminal", "label": "终态", "focus": ["success", "failed", "canceled"], "note": "成功、失败、取消都是可观察且不可随意回跳的终态。" }
    ]
  },
  "lanes": [
    { "id": "main", "label": "主任务阶段" },
    { "id": "recovery", "label": "恢复与退避" },
    { "id": "terminal", "label": "终态" }
  ],
  "states": [
    { "id": "pending", "type": "start", "label": "待执行", "sublabel": "已创建、待调度", "lane": "main", "col": 0, "step": "01", "tag": "受理" },
    { "id": "running", "type": "active", "label": "执行中", "sublabel": "领取任务与资源配额", "lane": "main", "col": 1, "step": "02", "tag": "运行" },
    { "id": "snapshot", "type": "active", "label": "生成快照", "sublabel": "固定目录视图", "lane": "main", "col": 2, "step": "03", "tag": "检查点" },
    { "id": "writing", "type": "decision", "label": "展开并写入", "sublabel": "分批路径与临时文件", "lane": "main", "col": 3, "step": "04", "tag": "检查点" },
    { "id": "success", "type": "success", "label": "交付成功", "sublabel": "原子提交正式产物", "lane": "main", "col": 4, "step": "05", "tag": "终态" },
    { "id": "retry", "type": "waiting", "label": "等待重试", "sublabel": "退避后从检查点继续", "lane": "recovery", "col": 2, "tag": "可恢复" },
    { "id": "failed", "type": "failure", "label": "失败", "sublabel": "超出重试预算或确定性错误", "lane": "terminal", "col": 2, "tag": "终态" },
    { "id": "canceled", "type": "failure", "label": "已取消", "sublabel": "尚未提交正式产物", "lane": "terminal", "col": 0, "tag": "终态" }
  ],
  "transitions": [
    { "id": "snapshot-retry", "from": "snapshot", "to": "retry", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight", "via": [[402, 230], [710, 230]] },
    { "id": "retry-snapshot", "from": "retry", "to": "snapshot", "variant": "dashed", "fromSide": "bottom", "toSide": "bottom", "route": "straight", "via": [[710, 360], [402, 360]] },
    { "id": "retry-failed", "from": "retry", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "id": "pending-canceled", "from": "pending", "to": "canceled", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "bottom-channel" }
  ],
  "cards": [
    { "dot": "emerald", "title": "检查点分层", "items": ["快照完成后可不重复读取目录", "行文件完成后可不重复展开路径", "正式文件只在全部成功后出现"] },
    { "dot": "orange", "title": "重试有边界", "items": ["只重试短暂性失败", "指数退避避免资源雪崩", "确定性错误直接失败并给出原因"] }
  ]
}
