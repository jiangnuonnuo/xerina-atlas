    { "id": "running", "kind": "double_rect", "x": 405, "y": 120, "width": 180, "height": 82, "label": "RUNNING", "sublabel": "单执行器领取", "fill": "#fff7ed", "stroke": "#fb923c", "flat": true },
    { "id": "success", "kind": "document", "x": 815, "y": 80, "width": 180, "height": 82, "label": "SUCCESS", "sublabel": "文件已提交", "fill": "#f0fdf4", "stroke": "#4ade80" },
    { "id": "retrying", "kind": "rect", "x": 405, "y": 310, "width": 180, "height": 82, "label": "RETRYING", "sublabel": "指数退避", "fill": "#faf5ff", "stroke": "#a78bfa", "flat": true },
    { "id": "failed", "kind": "rect", "x": 815, "y": 310, "width": 180, "height": 82, "label": "FAILED", "sublabel": "不可重试或耗尽", "fill": "#fef2f2", "stroke": "#f87171", "flat": true },
    { "id": "canceled", "kind": "rect", "x": 105, "y": 310, "width": 180, "height": 82, "label": "CANCELED", "sublabel": "仅等待态可取消", "fill": "#f3f4f6", "stroke": "#9ca3af", "flat": true }
