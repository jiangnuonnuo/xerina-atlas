    { "id": "one-worker", "source": "claim-one", "target": "worker", "source_port": "bottom", "target_port": "top", "flow": "data", "label": "execute", "label_style": "offset" },
    { "id": "worker-success", "source": "worker", "target": "success", "source_port": "right", "target_port": "left", "flow": "write", "label": "complete", "label_style": "offset" },
    { "id": "worker-retry", "source": "worker", "target": "retry", "source_port": "right", "target_port": "left", "flow": "async", "label": "transient", "label_style": "offset" },
    { "id": "retry-pending", "source": "retry", "target": "pending", "source_port": "top", "target_port": "bottom", "flow": "control", "label": "next due", "label_style": "offset" },
    { "id": "worker-failed", "source": "worker", "target": "failed", "source_port": "bottom", "target_port": "top", "flow": "error", "label": "final", "label_style": "offset" },
    { "id": "restart-pending", "source": "restart", "target": "pending", "source_port": "top", "target_port": "bottom", "flow": "control", "label": "recover once", "label_style": "offset" }
  ],
  "legend_orientation": "horizontal",
  "legend_x": 70,
  "legend_y": 785,
  "legend_locked": false,
  "legend": [
    { "flow": "control", "label": "任务扫描/状态" },
    { "flow": "write", "label": "成功状态" },
    { "flow": "async", "label": "重试/队列" },
    { "flow": "error", "label": "退出/失败" }
