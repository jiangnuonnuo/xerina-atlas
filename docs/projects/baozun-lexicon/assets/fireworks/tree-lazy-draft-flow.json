  "nodes": [
    { "id": "open", "kind": "rect", "x": 70, "y": 150, "width": 170, "height": 64, "label": "打开平台", "sublabel": "只取 roots" , "fill": "#eff6ff", "stroke": "#93c5fd", "flat": true},
    { "id": "roots", "kind": "rect", "x": 285, "y": 150, "width": 190, "height": 64, "label": "根节点游标页", "sublabel": "sort_order + id", "fill": "#eff6ff", "stroke": "#60a5fa", "flat": true},
    { "id": "expand", "kind": "rect", "x": 520, "y": 150, "width": 190, "height": 64, "label": "展开节点", "sublabel": "hasChildren 入口", "fill": "#f0fdfa", "stroke": "#5eead4", "flat": true},
    { "id": "children", "kind": "rect", "x": 755, "y": 150, "width": 190, "height": 64, "label": "直接子节点", "sublabel": "按页增量合并", "fill": "#f0fdfa", "stroke": "#14b8a6", "flat": true},
    { "id": "version", "kind": "rect", "x": 990, "y": 150, "width": 140, "height": 64, "label": "tree_version", "sublabel": "失效分支", "fill": "#fff7ed", "stroke": "#fb923c", "flat": true},
    { "id": "draft", "kind": "double_rect", "x": 150, "y": 350, "width": 200, "height": 64, "label": "FieldTreeDraft", "sublabel": "可编辑、可回放", "fill": "#faf5ff", "stroke": "#a78bfa", "flat": true},
    { "id": "review", "kind": "rect", "x": 475, "y": 350, "width": 200, "height": 64, "label": "人工确认", "sublabel": "逐项或整批接受", "fill": "#fff7ed", "stroke": "#fb923c", "flat": true},
    { "id": "command", "kind": "rect", "x": 800, "y": 350, "width": 200, "height": 64, "label": "CatalogCommand", "sublabel": "带基线版本提交", "fill": "#f0fdf4", "stroke": "#4ade80", "flat": true}
