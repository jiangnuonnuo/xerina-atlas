  "arrows": [
    { "id": "roots-read", "source": "open", "target": "roots", "source_port": "right", "target_port": "left", "flow": "read" },
    { "id": "expand-read", "source": "roots", "target": "expand", "source_port": "right", "target_port": "left", "flow": "control" },
